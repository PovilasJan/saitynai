    {
      "name": "Autentifikacija",
      "item": [
        {
          "name": "Prisijungti (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statusas 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json();",
                  "pm.test(\"Grąžinti žetonai\", () => { pm.expect(j.accessToken).to.be.a(\"string\"); pm.expect(j.user.role).to.eql(\"admin\"); });",
                  "pm.collectionVariables.set(\"accessToken\", j.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", j.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Atnaujinti žetoną (refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statusas 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json();",
                  "pm.test(\"Naujas refresh žetonas\", () => pm.expect(j.refreshToken).to.not.eql(pm.collectionVariables.get(\"refreshToken\")));",
                  "pm.collectionVariables.set(\"oldRefresh\", pm.collectionVariables.get(\"refreshToken\"));",
                  "pm.collectionVariables.set(\"accessToken\", j.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", j.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
