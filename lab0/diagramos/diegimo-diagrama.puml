@startuml diegimo-diagrama
!pragma layout smetana
title EuroDroneHub - UML diegimo (deployment) diagrama

node "Naudotojo įrenginys" <<device>> as PC {
  node "Naršyklė" <<execution environment>> as Browser {
    artifact "React SPA\n(index.html, JS, CSS)" <<artifact>> as SPA
  }
}

node "Railway debesis" <<device>> as Cloud {
  node "Docker konteineris\nNode.js 22" <<execution environment>> as Docker {
    component "Express REST API\n/api/*" as API
    component "Swagger UI\n/api-docs" as Swagger
    artifact "lab3/client/dist\n(statiniai failai)" <<artifact>> as Dist
    database "SQLite\n/data/data.db" as DB
  }
  storage "Railway Volume\n/data" as Vol
}

SPA ..> Dist : HTTPS GET
SPA --> API : HTTPS / REST / JSON\nAuthorization: Bearer JWT
API --> DB : SQL
DB ..> Vol : saugoma
Swagger ..> API
@enduml
