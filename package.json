{
  "name": "eurodronehub",
  "version": "1.0.0",
  "private": true,
  "description": "EuroDroneHub - KTU Saityno taikomųjų programų projektavimas",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node --no-warnings server/src/index.js",
    "dev:api": "node --no-warnings --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "seed": "node --no-warnings server/src/seed.js",
    "test:api": "npx newman run postman/EuroDroneHub.postman_collection.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
