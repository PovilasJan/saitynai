@startuml roliu-teises
!pragma layout smetana
title EuroDroneHub - autorizacijos veiklos diagrama
start
:Gaunama užklausa;
if (Yra Authorization: Bearer?) then (taip)
  if (JWT galioja?) then (ne)
    :401 Unauthorized;
    stop
  else (taip)
    :req.user = {id, username, role};
  endif
else (ne)
  :Svečias;
endif
if (Metodas GET?) then (taip)
  :Leidžiama visiems;
  stop
endif
if (Prisijungęs?) then (ne)
  :401 Unauthorized;
  stop
endif
if (Resursas = kategorija / dronas?) then (taip)
  if (role = admin?) then (taip)
    :Vykdoma;
  else (ne)
    :403 Forbidden;
  endif
else (atsiliepimas)
  if (POST arba savininkas arba admin?) then (taip)
    :Vykdoma;
  else (ne)
    :403 Forbidden;
  endif
endif
stop
@enduml
